print("script start")
bot:on("login", function()
	print("login handler")
	bot:chat("hi")
end)
bot:on("chat", function(p)
	print("chat:", p.content, p.sender, p.is_whisper)
	bot:wait_ticks(2) -- yields (async method)
	local pos = bot:position()
	print(string.format("pos %.1f %.1f %.1f", pos.x, pos.y, pos.z))
	bot:goto_xz(10, 20)
	bot:goto({ x = 1, y = 2, z = 3 })
	print("health", bot:health())
	print("bad enum:", pcall(function() bot:walk("sideways" :: any) end))
	print("bad pos:", pcall(function() bot:goto({ x = "a" } :: any) end))
	print("result err:", pcall(function() return bot:broken() end))
	print("uuid ok:", bot:entity_id_by_uuid("abcd-ef"))
	print("uuid bad:", pcall(function() return bot:entity_id_by_uuid("x") end))
	local xp = bot:experience()
	print("xp", xp.level, xp.progress, xp.total)
	print("tab", #bot:tab_names())
	bot:walk("forward")
	bot:write_chat_packet("raw")
	bot:mine_with_auto_tool({ x = 1, y = 2, z = 3 })
	bot:goto_with_opts({ x = 1, y = 2, z = 3 }, { allow_mining = false })
	bot:attack(bot:entity_id_by_uuid("abcd-ef") :: Entity)
end)
bot:on("keep_alive", function(id) print("keep_alive", id) end)
bot:on("death", function(info)
	print("death handler", info and info.player_id, info and info.message)
	if info then print("tick after death", select("#", bot:wait_for("tick"))) end
end)
print("unknown event:", pcall(function() bot:on("nope" :: any, function() end) end))
bot:wait_ticks(1)
-- Entity class (generated from EntityRef)
local ent = bot:entity_id_by_uuid("abcd-ef")
local ep = ent:position()
print(string.format("entity pos %.1f %.1f %.1f health %s", ep.x, ep.y, ep.z, tostring(ent:health())))
ent:attack()
-- class-typed returns/params (step 3): T, Option<T>, Vec<T>, Box<[T]>
local me = bot:entity()
local other = bot:entity_by_uuid("abcd-ef")
print("me", tostring(me), me:position().x, "other", tostring(other), other:distance_to(me)) -- extra_entity.rs: 2 blocks
print("missing", bot:entity_by_uuid("none"))
local players = bot:nearby_players()
print("players", #players, tostring(players[2]))
print("count", bot:test_count_entities(me, nil, players), bot:test_count_entities(me, other, {}), bot:test_count_boxed(players))
print("all", #bot:test_all_entities())
print("bad entity arg:", pcall(function() return bot:test_count_entities("x" :: any, nil, {}) end))
print("bad list arg:", pcall(function() return bot:test_count_boxed({ 1 } :: any) end))
-- step 4: identity, Minecraft ids, entity_ref_for, ECS-id params
print("eq", me == bot:entity(), me == other, me ~= other, ent == other)
print("ids", me:minecraft_id(), bot:minecraft_id(), bot:entity_by_minecraft_id(12) == other, bot:entity_by_minecraft_id(-1))
print("ref_for", bot:entity_ref_for(other) == other, bot:entity_id_by_minecraft_id(12) == other)
print("bad id:", pcall(function() return bot:entity_by_minecraft_id(1.5) end))
print("bad id type:", pcall(function() return bot:entity_by_minecraft_id("a" :: any) end))
bot:attack(other)
bot:entity_interact(other)
-- step 5: hand-written queries (extra_query.rs)
local np = bot:nearest_player()
print("nearest_player", tostring(np), np ~= nil and np == bot:nearby_players()[1])
local all = bot:nearby_entities()
local zombies = bot:nearby_entities("zombie")
local ns = bot:nearby_entities("minecraft:cow")
print("nearby", #all, #zombies, #ns, tostring(zombies[1]), tostring(all[1]))
for _, e in ipairs(all) do assert(e ~= bot:entity(), "bot must not be in nearby_entities") end
print("no kind match:", #bot:nearby_entities("player"))
print("bad kind:", pcall(function() return bot:nearby_entities("nope") end))
print("bad kind type:", pcall(function() return bot:nearby_entities(5 :: any) end))
-- step 6: state tables (extra_state.rs)
local dir = bot:direction()
print("direction", dir.y_rot, dir.x_rot)
local prof, acc = bot:profile(), bot:account()
print("profile", prof.name, prof.uuid, "account", acc.username, acc.uuid)
local ph = bot:physics()
print("physics", ph.velocity.y, ph.on_ground, ph.horizontal_collision, ph.fall_distance, ph.remaining_fire_ticks)
local eph = other:physics()
print("entity physics", eph.velocity.y, eph.on_ground, ph.was_touching_water, ph.vertical_collision)
local at = bot:attributes()
print("attributes", at.movement_speed.base, at.movement_speed.value, at.step_height.value, other:attributes().attack_speed.base)
local n = 0
for _ in pairs(at) do n += 1 end
print("attribute count", n)
local tl = bot:tab_list()
print("tab_list", #tl, tl[1].name, tl[1].uuid, tl[1].latency, tl[1].gamemode, tl[2].name)
local hit = bot:hit_result()
print("hit block", hit.kind, hit.block_pos.y, hit.location.x, hit.direction, hit.miss, hit.inside, hit.entity)
local hit2 = bot:hit_result()
print("hit entity", hit2.kind, hit2.location.z, tostring(hit2.entity), hit2.entity == other, hit2.block_pos)
-- step 7: items (Item = { kind, count } | nil)
local held = bot:held_item()
print("held", held.kind, held.count, "generated get_held_item (now empty):", bot:get_held_item(), bot:held_item())
-- step 8: inventory + menu
local inv = bot:inventory()
print("inventory", #inv, inv[1], inv[2].kind, inv[2].count, inv[3], inv[4].kind, inv[4].count)
local menu = bot:menu()
print("menu", menu.kind, #menu.slots, menu.slots[1].kind, menu.slots[1].count, menu.slots[2], menu.slots[3].kind)
local n = 0
for _, slot in ipairs(inv) do n += slot and 1 or 0 end
print("non-empty", n)
-- step 9: containers (Container class from ContainerHandle)
local pos = { x = 1, y = 64, z = 2 }
local own = bot:open_inventory()
print("open_inventory", #own:slots(), own:slots()[2].kind)
own:close()
own:close()
print("closed slots", own:slots())
local chest = bot:open_container_at(pos)
local cs = chest:slots()
print("chest", #cs, cs[1].kind, cs[1].count, cs[2], cs[3].kind)
print("timeout nil", bot:open_container_at_with_timeout_ticks(pos, 0), bot:wait_for_container_open(0))
print("no timeout", bot:open_container_at_with_timeout_ticks(pos, nil) ~= nil, (bot:open_container_at_with_timeout_ticks(pos, 40) :: any):slots()[1].kind)
print("waited", (bot:wait_for_container_open() :: any):slots()[1].kind, bot:wait_for_container_open(20) ~= nil)
print("bad pos:", pcall(function() return bot:open_container_at({ x = 0, y = -1, z = 0 }) end))
print("bad ticks:", pcall(function() return bot:open_container_at_with_timeout_ticks(pos, -1) end))
print("bad ticks type:", pcall(function() return bot:wait_for_container_open("soon" :: any) end))
chest:close()
-- step 10: container clicks (slots are 0-based: slots()[slot + 1])
local box = bot:open_container_at(pos)
box:left_click(0)
box:right_click(1)
box:shift_click(2)
box:middle_click(0)
box:double_click(1)
box:swap(0, 8)
box:swap(2, 40)
box:throw(0)
box:throw(1, true)
box:drop_cursor()
box:drop_cursor(true)
print("bad slot:", pcall(function() box:left_click(3) end))
print("bad slot wrap:", pcall(function() box:throw(65536) end))
print("bad slot neg:", pcall(function() box:shift_click(-1) end))
print("bad slot frac:", pcall(function() box:right_click(0.5) end))
print("bad swap target:", pcall(function() box:swap(0, 9) end))
print("bad swap range:", pcall(function() box:swap(0, 256) end))
box:close()
print("closed click:", pcall(function() box:left_click(0) end))
print("closed drop:", pcall(function() box:drop_cursor() end))
-- step 11: blocks (names are "minecraft:<id>"; inputs also accept the bare id)
print("block_at", bot:block_at({ x = 0, y = 0, z = 0 }), bot:block_at({ x = 1, y = 30, z = 1 }), bot:block_at({ x = 1, y = 63, z = 1 }), bot:block_at({ x = 1, y = 64, z = 2 }))
print("block_at special", bot:block_at({ x = 5, y = 10, z = 5 }), bot:block_at({ x = 3, y = 63, z = 3 }))
print("block_at unloaded", bot:block_at({ x = 0, y = -1, z = 0 }))
print("block_at floors", bot:block_at({ x = 0.9, y = 30.7, z = 0.2 }))
print("block_at bad arg:", pcall(function() return bot:block_at("stone" :: any) end))
local tool = bot:best_tool_in_hotbar_for_block("minecraft:stone")
print("best tool", tool.slot, tool.percentage_per_tick)
print("best tool bare", bot:best_tool_in_hotbar_for_block("bedrock").slot, bot:best_tool_in_hotbar_for_block("bedrock").percentage_per_tick)
print("best_tool_for", bot:best_tool_for("stone"), bot:best_tool_for("minecraft:dirt"), bot:best_tool_for("oak_log"), bot:best_tool_for("diamond_ore"), bot:best_tool_for("air"))
print("best_tool_for nil", bot:best_tool_for("water"), bot:best_tool_for("bedrock"), bot:best_tool_for("minecraft:lava"))
print("block_at -> best_tool_for", bot:best_tool_for(bot:block_at({ x = 1, y = 30, z = 1 }) :: any), bot:best_tool_for(bot:block_at({ x = 1, y = 63, z = 1 }) :: any))
print("unknown block:", pcall(function() return bot:best_tool_for("unobtainium") end))
print("unknown block 2:", pcall(function() return bot:best_tool_in_hotbar_for_block("minecraft:nope") end))
print("bad block type:", pcall(function() return bot:best_tool_for(12 :: any) end))
-- step 12: goto_reach, set_client_information, wait_for (extra_misc.rs, mod.rs)
local chestpos = { x = 1, y = 64, z = 2 }
bot:goto_reach(chestpos)
bot:goto_reach(chestpos, 2.5)
print("bad reach 0:", pcall(function() bot:goto_reach(chestpos, 0) end))
print("bad reach neg:", pcall(function() bot:goto_reach(chestpos, -1) end))
print("bad reach pos:", pcall(function() bot:goto_reach("here" :: any) end))
bot:set_client_information({ language = "tl_ph", view_distance = 12, chat_visibility = "system", main_hand = "left", model_customization = { cape = false, hat = false }, particle_status = "minimal" })
bot:set_client_information({})
print("bad info field:", pcall(function() bot:set_client_information({ langauge = "x" }) end))
print("bad info enum:", pcall(function() bot:set_client_information({ main_hand = "middle" }) end))
print("bad info view:", pcall(function() bot:set_client_information({ view_distance = 300 }) end))
print("bad info bool:", pcall(function() bot:set_client_information({ chat_colors = "yes" }) end))
print("bad info skin:", pcall(function() bot:set_client_information({ model_customization = { tail = true } }) end))
print("bad info table:", pcall(function() bot:set_client_information("en" :: any) end))
print("bad wait_for:", pcall(function() return bot:wait_for("nope" :: any) end))
-- step 5 (full coverage): Init already happened (the script runs inside it): `init` handlers are replayed, wait_for("init") returns at once
bot:on("init", function() print("init handler replayed") end)
print("wait_for init:", select("#", bot:wait_for("init")))
local id = bot:wait_for("keep_alive") -- the script body can wait too; the harness fires keep_alive last
print("body woke on keep_alive", id)
print("script end")
