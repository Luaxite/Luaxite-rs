    --- The block at `pos` as a name like "minecraft:stone" ("minecraft:air" for air), or nil when that position isn't in a loaded chunk. Reads the loaded world and never yields.
    function block_at(self, pos: BlockPos): string?
    --- Which hotbar slot mines `block` (a name like "stone" or "minecraft:stone") fastest. `slot` is 0-based, as `set_selected_hotbar_slot` takes it; `percentage_per_tick` is the mining progress per tick with that slot (0 when the block can't be mined, like water or bedrock). Unknown names are an error.
    function best_tool_in_hotbar_for_block(self, block: string): { slot: number, percentage_per_tick: number }
    --- The hotbar slot (0-based, for `set_selected_hotbar_slot`) that mines `block` fastest, or nil when no slot can mine it (water, lava, bedrock). Unknown names are an error.
    function best_tool_for(self, block: string): number?
    --- The item in the bot's main hand, or nil when the hand is empty.
    function held_item(self): Item?
    --- The bot's own inventory (not an open chest) in slot order: crafting, armor, main inventory, hotbar, offhand. An empty slot is `false`.
    function inventory(self): { Item | false }
    --- Yields until the bot can reach the block at `pos`: it stands next to it, or can look at it and hit it from within `distance` blocks (default 4.5). Use it to walk up to a chest before `open_container_at`, or to a block before `mine`. Raises an error if the world isn't loaded yet or `distance` isn't a positive number.
    function goto_reach(self, pos: BlockPos, distance: number?): ()
    --- Change the client settings the server sees (language, view distance, chat visibility, skin parts, main hand, ...). Pass only the fields you want; every field you leave out is azalea's default (`language = "en_us"`, `view_distance = 8`, ...), not the value an earlier call set. If the bot is logged in the settings are sent right away, otherwise they are used when it logs in. Unknown fields and bad values are errors.
    function set_client_information(self, info: { language: string?, view_distance: number?, chat_visibility: ("full" | "system" | "hidden")?, chat_colors: boolean?, model_customization: { cape: boolean?, jacket: boolean?, left_sleeve: boolean?, right_sleeve: boolean?, left_pants: boolean?, right_pants: boolean?, hat: boolean? }?, main_hand: ("left" | "right")?, text_filtering_enabled: boolean?, allows_listing: boolean?, particle_status: ("all" | "decreased" | "minimal")? }): ()
    --- The closest other player in render distance, or nil when nobody is around.
    function nearest_player(self): Entity?
    --- Entities in render distance (nearest first, not including the bot). With `kind` (like "zombie" or "minecraft:zombie") only entities of that type are returned. Unknown kinds are an error.
    function nearby_entities(self, kind: string?): { Entity }
    --- The account the bot logged in with.
    function account(self): { username: string, uuid: string }
    --- Everyone in the tab list, sorted by name.
    function tab_list(self): { PlayerInfo }
    --- Every ECS component and resource a script can name: `{ name, kind = "component" | "resource", luau (the Luau type of its value), readable }`, in name order. Types with `readable = false` exist in azalea but have no Luau conversion. Never yields.
    function ecs_names(self): { { name: string, kind: string, luau: string, readable: boolean } }
    --- The value of a component of the bot's own entity (name from `ecs_names`, e.g. "Health"). Errors when the bot lacks it or the name is unknown/unreadable. Never yields.
    function component(self, name: string): any
    --- Like `component`, but nil when the bot lacks the component. Never yields.
    function get_component(self, name: string): any?
    --- The value of a component of another entity. Errors when the entity lacks it. Never yields.
    function entity_component(self, entity: Entity, name: string): any
    --- Like `entity_component`, but nil when the entity lacks the component. Never yields.
    function get_entity_component(self, entity: Entity, name: string): any?
    --- The value of an ECS resource (name from `ecs_names`). Errors when the resource is missing. Never yields.
    function resource(self, name: string): any
    --- Calls `fn(value)` with an ECS resource and returns what it returns. Errors when the resource is missing.
    function map_resource(self, name: string, f: (value: any) -> any): any
    --- Calls `fn(value)` with an ECS resource, or `fn(nil)` when it is missing, and returns what it returns.
    function map_get_resource(self, name: string, f: (value: any?) -> any): any
    --- Read-only snapshot query on the bot's entity: `fn({ [name] = value })` is called with the named components and its result returned. Errors when a component is missing.
    function query_self(self, names: { string }, f: (row: { [string]: any }) -> any): any
    --- Like `query_self`, but returns nil (without calling `fn`) when a component is missing.
    function try_query_self(self, names: { string }, f: (row: { [string]: any }) -> any): any?
    --- Read-only snapshot query on another entity (see `query_self`). Errors when a component is missing.
    function query_entity(self, entity: Entity, names: { string }, f: (row: { [string]: any }) -> any): any
    --- Like `query_entity`, but returns nil (without calling `fn`) when a component is missing.
    function try_query_entity(self, entity: Entity, names: { string }, f: (row: { [string]: any }) -> any): any?
    --- Yields until the next game tick (20 per second).
    function wait_tick(self): ()
    --- Yields until the next ECS update (at least once per tick, usually faster).
    function wait_update(self): ()
    --- Yields until the pathfinder has reached `goal` (see the `goal` functions) or pathfinding is canceled.
    function goto_goal(self, goal: Goal, opts: PathfinderOpts?): ()
    --- Start pathfinding to `goal` and return at once (it does not wait; see `is_goto_target_reached`).
    function start_goto_goal(self, goal: Goal, opts: PathfinderOpts?): ()
    --- Goal: be able to reach the block at `pos` (stand next to it, or see it and hit it from within `distance` blocks, default azalea's reach). Needs the world to be loaded.
    function reach_goal(self, pos: BlockPos, distance: number?): Goal
    --- Queues a serverbound game packet (`kind` and the `fields` table follow the `OutPacket<Kind>` types; kinds without a constructor are listed in GEN_REPORT.md). Sent on the next ECS update; never yields. Errors on an unknown kind or a bad field.
    function write_packet(self, kind: OutPacketKind, fields: { [string]: any }?): ()
    --- Read-only snapshot of the connection: `state` ("handshake"|"game"|"status"|"login"|"configuration"), `is_alive`, and `injected` (raw clientbound packets queued for injection, as strings). Never yields.
    function raw_connection(self): { state: string, is_alive: boolean, injected: { string } }
    --- Calls `fn(conn)` with the snapshot of `raw_connection()`; afterwards `conn.state` and `conn.injected` (strings of raw clientbound packet bytes) are written back to the connection. `is_alive` is read-only. This changes how azalea treats the connection: use with care.
    function raw_connection_mut(self, f: (conn: { state: string, is_alive: boolean, injected: { string } }) -> ()): ()
    --- Names of the data registries the server sends ("enchantment", "worldgen/biome", "damage_type", ...); any of them (also `biome`, or with `minecraft:`) works as the `registry` argument of the `registry_*` methods.
    function registry_kinds(self): { string }
    --- All entry names of a data registry ("minecraft:plains", ...) in protocol-id order, so `registry_name(r, i)` is entry `i + 1` of this list. Empty before the server sent the registry. Errors on an unknown registry. Never yields.
    function registry_entries(self, registry: string): { string }
    --- The protocol id of the entry `name` ("plains" or "minecraft:plains") in a data registry, or nil when the server has no such entry. Never yields.
    function registry_resolve(self, registry: string, name: string): number?
    --- The name of the entry with protocol id `id` in a data registry (e.g. a biome id from a packet), or nil when there is none. Never yields.
    function registry_name(self, registry: string, id: number): string?
    --- `{ name, id }` of the entry `name` in a data registry, or nil when the server has no such entry. The entry's data (NBT) is not exposed. Never yields.
    function registry_get(self, registry: string, name: string): { name: string, id: number }?
    --- Every other entity in the bot's world (nearest first, not including the bot), optionally only those of one type (`kind` like "zombie" or "minecraft:zombie"; unknown kinds are an error). Never yields. BREAKING: older versions included the bot itself (see CHANGELOG.md).
    function nearest_entities(self, kind: string?): { Entity }
    --- Some entity whose components `names` (see `ecs_names`) pass `pred(row, entity)` (row = `{ [name] = value }`, a snapshot), or nil. In practice the nearest one. The bot itself is not a candidate. `pred` may yield. BREAKING: older versions included the bot itself (see CHANGELOG.md).
    function any_entity_by(self, names: { string }, pred: (row: { [string]: any }, entity: Entity) -> boolean?): Entity?
    --- The nearest other entity (not the bot) whose components `names` pass `pred(row, entity)`, or nil. `pred` may yield. BREAKING: older versions included the bot itself (see CHANGELOG.md).
    function nearest_entity_by(self, names: { string }, pred: (row: { [string]: any }, entity: Entity) -> boolean?): Entity?
    --- Every other entity (nearest first, not the bot) whose components `names` pass `pred(row, entity)`. `pred` may yield. BREAKING: older versions included the bot itself (see CHANGELOG.md).
    function nearest_entities_by(self, names: { string }, pred: (row: { [string]: any }, entity: Entity) -> boolean?): { Entity }
    --- A handle on the bot's world, for block reads and block searches (see `World`). Never yields.
    function world(self): World
    --- Like `world()`, but only the chunks this bot itself has loaded (inside its view distance) count as loaded. It differs from `world()` only when several bots share one world.
    function partial_world(self): World
    --- The name of the world (dimension) the bot is in, like "minecraft:overworld". Two bots or entities with the same name are in the same world.
    function world_name(self): string
end

