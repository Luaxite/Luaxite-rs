-- An open container (a chest, or the bot's own inventory). It closes on `close()` or when garbage collected.
declare extern type Container with
    --- Every slot of the container followed by the bot's inventory, in slot order (an empty slot is `false`). nil once closed.
    function slots(self): { Item | false }?
    --- Close the container. Closing twice does nothing.
    function close(self): ()
    --- Left-click a slot: pick up or put down the whole stack.
    function left_click(self, slot: number): ()
    --- Right-click a slot: pick up half the stack or put down one item.
    function right_click(self, slot: number): ()
    --- Shift-click a slot: move its stack to the other part of the menu.
    function shift_click(self, slot: number): ()
    --- Middle-click a slot: copy its stack onto the cursor. Only works in creative mode.
    function middle_click(self, slot: number): ()
    --- Double-click a slot: gather matching items onto the cursor stack.
    function double_click(self, slot: number): ()
    --- Swap a slot with a hotbar slot (`target` 0-8) or the offhand (`target` 40), like pressing a number key or F.
    function swap(self, slot: number, target: number): ()
    --- Drop the item in a slot (the Q key): one item, or the whole stack with `whole_stack`.
    function throw(self, slot: number, whole_stack: boolean?): ()
    --- Click outside the menu to drop the item on the cursor: one item, or the whole stack with `whole_stack`.
    function drop_cursor(self, whole_stack: boolean?): ()
    --- Drag-click: hold a mouse button and sweep over `slots` (0-based slot numbers, like the other clicks) to spread the item on the cursor over them. `kind` is the button: "left" splits the stack evenly, "right" puts one item in each slot, "middle" is creative-mode only. A closed container, an unknown `kind`, an empty `slots` list or a missing slot is an error.
    function quick_craft(self, kind: "left" | "right" | "middle", slots: { number }): ()
    --- The window id of the container (0 is the bot's own inventory). nil once closed.
    function id(self): number?
    --- The container's title as plain text (like "Chest"), or nil when it has none or is closed.
    function title(self): string?
    --- Only the container's own slots, without the bot's inventory that `slots()` appends (an empty slot is `false`). nil once closed.
    function contents(self): { Item | false }?
end

-- The bot's loaded world: block reads and block searches. Get one with `bot:world()`.
declare extern type World with
    --- The block at `pos` as a name like "minecraft:stone" ("minecraft:air" for air), or nil when that position isn't in a loaded chunk. Never yields.
    function block_state(self, pos: BlockPos): string?
    --- Whether the chunk with chunk coordinates `chunk_x`, `chunk_z` (block coordinate // 16) is loaded.
    function is_chunk_loaded(self, chunk_x: number, chunk_z: number): boolean
    --- Whether the chunk that contains the block position `pos` is loaded.
    function chunk_loaded(self, pos: BlockPos): boolean
    --- The biome at `pos` as a name like "minecraft:plains", or nil when the position isn't loaded or the server never sent that biome's name. Never yields.
    function biome(self, pos: BlockPos): string?
    --- The y of the highest block in the column at block coordinates `x`, `z` that isn't air, or nil when the column isn't loaded (or holds only air). Looks from y=319 down to y=-64.
    function height(self, x: number, z: number): number?
    --- The loaded block nearest to `from` (default: the bot's block) whose name is `block` (a name like "stone" or "minecraft:stone", or a table of names), no further than `max_distance` blocks away (default: no limit), or nil. Unknown names are an error. Never yields; searching a large loaded area takes a moment.
    function find_block(self, block: string | { string }, from: BlockPos?, max_distance: number?): BlockPos?
    --- Loaded blocks named `block` (see `find_block`) within `max_distance` of `from`, nearest first, at most `limit` (default 256).
    function find_blocks(self, block: string | { string }, from: BlockPos?, max_distance: number?, limit: number?): { BlockPos }
end

-- A pathfinding goal. Make one with the `goal` functions or `bot:reach_goal(..)`; combine them with `goal.all/any/inverse`; use it with `bot:goto_goal(goal)`.
declare extern type Goal with
    --- The goal as text (azalea's debug form), e.g. for printing while debugging.
    function describe(self): string
end

-- The `goal` global: goal constructors and combinators.
declare extern type GoalLib with
    --- Goal: stand on this block.
    block: (pos: BlockPos) -> Goal
    --- Goal: reach this x and z, at any height.
    xz: (x: number, z: number) -> Goal
    --- Goal: reach this height (y), anywhere.
    y: (y: number) -> Goal
    --- Goal: get within `radius` blocks of `pos`.
    radius: (pos: Vec3, radius: number) -> Goal
    --- Goal reached when every given goal is reached at once (at least one goal).
    all: (...Goal) -> Goal
    --- Goal reached when any one of the given goals is reached (at least one goal).
    any: (...Goal) -> Goal
    --- Goal reached everywhere the given goal is not (e.g. "get away from this block").
    inverse: (goal: Goal) -> Goal
end

-- A running azalea swarm. Start one with `azalea.swarm{ address }`, add bots with `swarm:add(account)`.
declare extern type Swarm with
    --- Adds a bot to the swarm and returns it once it exists (yields). `account` is a name (offline), `{ name }` or `{ microsoft = cache key }`. The bot has its own `on`/`wait_for` handlers, like one from `azalea.join`.
    function add(self, account: string | { name: string?, microsoft: string? }): Bot
    --- Ends the whole swarm (every bot in it).
    function exit(self): ()
end

-- The `azalea` global: `join` a server with a bot, start a `swarm`, `wait` for the bots to leave.
declare extern type AzaleaLib with
    --- Joins a server with a new bot and returns it once it is created (yields; the login itself continues in the background, wait for `init`/`login` events as usual). `account` is a name (offline), `{ name }` or `{ microsoft = cache key }`; `address` is "host[:port]"; `proxy` is an optional SOCKS5 "ip:port" (no login). The returned bot has its own `on`/`wait_for` handlers.
    join: (opts: { account: string | { name: string? , microsoft: string? }, address: string, proxy: string? }) -> Bot
    --- Yields until every bot made by `join` / `swarm:add` has disconnected and every swarm has ended (returns at once when there is none). Only needed to run code after that: the process stays up on its own while anything is still running, even after the script has ended.
    wait: () -> ()
    --- Starts an azalea Swarm that joins `address` and returns it once it is running (yields). Add bots with `swarm:add(account)`; `swarm:exit()` ends the whole swarm.
    swarm: (opts: { address: string }) -> Swarm
end

-- The `process` global: `process.exit(code)` ends the process.
declare extern type ProcessLib with
    --- Ends the process at once with exit code `code` (default 0), whatever bots / swarms are still running.
    exit: (code: number?) -> ()
end

-- A reference to an entity in the world (compare with ==).
declare extern type Entity with
    --- Attack this entity from the client that created this `EntityRef`.
    function attack(self): ()
    --- Returns the attribute values of the entity, which can be used to determine things like its movement speed.
    function attributes(self): Attributes
    --- Get the bounding box dimensions for the entity, which contains its width, height, and eye height.
    function dimensions(self): EntityDimensions
    --- Returns the distance between the client's feet position and this entity's feet position.
    function distance_to_client(self): number
    --- Returns whether the entity is in the world and hasn't despawned.
    function exists(self): boolean
    --- Get the position of this entity's eyes.
    function eye_position(self): Vec3
    --- Get the health of this entity, typically in the range `0..=20`.
    function health(self): number
    --- Right-click this entity from the client that created this `EntityRef`.
    function interact(self): ()
    --- Returns whether the entity is alive and hasn't despawned.
    function is_alive(self): boolean
    --- Look at this entity from the client that created the `EntityRef`.
    function look_at(self): ()
    --- Get the Minecraft ID of this entity.
    function minecraft_id(self): number
    --- Returns the complete `Physics` data for this entity, including velocity, bounding box, collisions, etc.
    function physics(self): Physics
    --- Get the entity's position in the world, which is the same as its feet position.
    function position(self): Vec3
    --- Get the Minecraft UUID of this entity.
    function uuid(self): string
